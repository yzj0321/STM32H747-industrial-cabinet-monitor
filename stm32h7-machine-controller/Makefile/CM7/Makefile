#######################################
# LDFLAGS
#######################################
# link script selected by APP_SLOT above

# libraries
LIBS = -lc -lm -lnosys
LIBDIR =
LDFLAGS = $(MCU) -specs=nano.specs -T$(LDSCRIPT) $(LIBDIR) $(LIBS) -Wl,-Map=$(BUILD_DIR)/$(TARGET).map,--cref -Wl,--gc-sections

# default action: build all
all: $(BUILD_DIR)/$(TARGET).elf $(BUILD_DIR)/$(TARGET).hex $(BUILD_DIR)/$(TARGET).bin

.PHONY: all slot-a slot-b all-slots pack-ab clean clean-slots

BOOTLOADER_BIN = ../../../Bootloader/Makefile/CM7/build/GPIO_CM7.bin
PACK_AB_SCRIPT = ../../../OTA/pack_ab_firmware.py

slot-a:
	$(MAKE) all APP_SLOT=A

slot-b:
	$(MAKE) all APP_SLOT=B

all-slots: slot-a slot-b
	@echo.
	@echo === CM7 dual-slot bins ready ===
	@echo   Slot A : build_A/$(TARGET_BASE)_A.bin  @ 0x08020000
	@echo   Slot B : build_B/$(TARGET_BASE)_B.bin  @ 0x080A0000
	@echo.

pack-ab: all-slots
	python $(PACK_AB_SCRIPT) --bl $(BOOTLOADER_BIN) \
	  --app-a build_A/$(TARGET_BASE)_A.bin \
	  --app-b build_B/$(TARGET_BASE)_B.bin \
	  --out build


#######################################
# build the application
#######################################
# list of objects
OBJECTS = $(addprefix $(BUILD_DIR)/,$(notdir $(C_SOURCES:.c=.o)))
vpath %.c $(sort $(dir $(C_SOURCES)))
# list of ASM program objects
OBJECTS += $(addprefix $(BUILD_DIR)/,$(notdir $(ASM_SOURCES:.s=.o)))
vpath %.s $(sort $(dir $(ASM_SOURCES)))
OBJECTS += $(addprefix $(BUILD_DIR)/,$(notdir $(ASMM_SOURCES:.S=.o)))
vpath %.S $(sort $(dir $(ASMM_SOURCES)))

$(BUILD_DIR)/%.o: %.c Makefile | $(BUILD_DIR)
	$(CC) -c $(CFLAGS) -Wa,-a,-ad,-alms=$(BUILD_DIR)/$(notdir $(<:.c=.lst)) $< -o $@

$(BUILD_DIR)/%.o: %.s Makefile | $(BUILD_DIR)
	$(AS) -c $(CFLAGS) $< -o $@
$(BUILD_DIR)/%.o: %.S Makefile | $(BUILD_DIR)
	$(AS) -c $(CFLAGS) $< -o $@

$(BUILD_DIR)/$(TARGET).elf: $(OBJECTS) Makefile $(LDSCRIPT)
	$(CC) $(OBJECTS) $(LDFLAGS) -o $@
	$(SZ) $@

$(BUILD_DIR)/%.hex: $(BUILD_DIR)/%.elf | $(BUILD_DIR)
	$(HEX) $< $@

$(BUILD_DIR)/%.bin: $(BUILD_DIR)/%.elf | $(BUILD_DIR)
	$(BIN) $< $@

$(BUILD_DIR):
	if not exist "$@" mkdir "$@"

#######################################
# clean up
#######################################
clean:
	-rm -fR build build_A build_B

clean-slots: clean

#######################################
# dependencies
#######################################
-include $(wildcard $(BUILD_DIR)/*.d)

